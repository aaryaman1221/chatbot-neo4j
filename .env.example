GITHUB_TOKEN=
GOOGLE_API_KEY=

# ── Neo4j ───────────────────────────────────────────────────────────────────
# Local Docker (docker compose up):        neo4j://localhost:7687
# From inside the compose network:         neo4j://neo4j:7687   (set for you)
# Neo4j AuraDB (managed cloud):             neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Comma-separated browser origins allowed to call the API (CORS).
# Add your deployed frontend origin (e.g. https://<app>.azurestaticapps.net).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

TARGET_REPO=owner/repo
MAX_COMMITS=30
SKIP_LLM=true

# ---------------------------------------------------------------------------
# Logging — DEBUG shows the full LLM prompt + raw Neo4j context, INFO for short
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
