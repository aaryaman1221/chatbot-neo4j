# Base URL the React app calls for the backend API (baked in at build time).
#
#   vite dev, backend on :8000 ............ http://localhost:8000/api
#   docker compose / nginx same-origin .... /api   (this is the build default)
#   Azure Static Web Apps ................. https://<backend-fqdn>/api
VITE_API_BASE=http://localhost:8000/api
